# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files with LF endings
*.py text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.example text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
