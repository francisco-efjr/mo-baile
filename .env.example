# Copie para .env e ajuste. Todos os valores tem padrao seguro; fora da faixa
# valida, o motor avisa no log e usa o padrao em vez de derrubar a aplicacao.

# --- iOS ---
# Endpoint do WebDriverAgent.
WDA_URL=http://localhost:8100
# Servidor Appium. É ele que instala, compila e mantém o WebDriverAgent de pé;
# o botão "Iniciar WebDriverAgent" abre uma sessão XCUITest por aqui.
APPIUM_URL=http://127.0.0.1:4723

# --- Android ---
# Caminho do adb. Em branco, o motor procura no PATH, no Homebrew e no SDK.
ADB_PATH=

# --- Geracao de codigo ---
PAGE_OBJECTS_KEY=onboarding_credito_objs
# position | xpath | id
DEFAULT_STRATEGY=position

# --- Espelho ---
# Quadros por segundo pedidos a captura (0.2 a 60). O quadro so sobe para a
# interface quando a tela muda, entao valor alto custa CPU de captura, nao de
# redesenho.
STREAM_FPS=3.5
# Intervalo de varredura de dispositivos, em segundos (0.2 a 60).
POLL_INTERVAL=1.5
# Diferenca media por pixel (0 a 255) entre miniaturas 32x32 para considerar
# que a tela mudou.
DIFF_THRESHOLD=3.5
# Tempo sem mudanca para considerar a tela estavel, em segundos.
SETTLE_DELAY=0.4

# --- Proxy de inspecao ---
PROXY_PORT=8082
# Mantenha em 127.0.0.1. O alcance ao aparelho vem do `adb reverse`; escutar em
# 0.0.0.0 transforma a maquina em proxy aberto para a rede local.
PROXY_HOST=127.0.0.1

# --- Privacidade ---
# 1 (padrao) redige Authorization, Cookie, senha, CPF e afins no trafego
# capturado. Use 0 apenas em depuracao pontual e consciente.
MOBAILE_REDACT=1
