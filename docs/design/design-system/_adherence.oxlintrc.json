{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/controls/**",
              "components/indicators/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/window/**",
              "ui_kits/macos-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SF Pro Text|SF Pro Display))/i]",
        "message": "Font not provided by the design system. Available: SF Pro Text, SF Pro Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessoryBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<AccessoryBar> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|message|iconSrc|buttons|onCancel|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: open, title, message, iconSrc, buttons, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|title|onClick|children|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled, title, onClick, children, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|destructive|destructive-fill|recording|plain|plain-destructive)$/]",
        "message": "<Button> variant must be one of 'default' | 'secondary' | 'destructive' | 'destructive-fill' | 'recording' | 'plain' | 'plain-destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:mini|small|regular|large)$/]",
        "message": "<Button> size must be one of 'mini' | 'small' | 'regular' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|help|disabled|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, help, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|variant|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<CountBadge> doesn't accept that prop. Declared props: value, variant, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:text|pill)$/]",
        "message": "<CountBadge> variant must be one of 'text' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|rowKey|selected|onSelectionChange|onOpen|sort|onSortChange|onRowContextMenu|newKeys|focused|empty|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, rowKey, selected, onSelectionChange, onOpen, sort, onSortChange, onRowContextMenu, newKeys, focused, empty, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeviceFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|notch|children|onMouseMove|onMouseLeave|onClick|screenRef|key|ref|className|style|children)$/]",
        "message": "<DeviceFrame> doesn't accept that prop. Declared props: width, height, notch, children, onMouseMove, onMouseLeave, onClick, screenRef."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagnosticCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:platform|title|ready|checks|actionLabel|onAction|actionDisabled|busy|footer|key|ref|className|style|children)$/]",
        "message": "<DiagnosticCard> doesn't accept that prop. Declared props: platform, title, ready, checks, actionLabel, onAction, actionDisabled, busy, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagnosticCard'] > JSXAttribute[name.name='platform'] > Literal[value!=/^(?:ios|android)$/]",
        "message": "<DiagnosticCard> platform must be one of 'ios' | 'android'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|text|actionLabel|onAction|loading|compact|children|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, text, actionLabel, onAction, loading, compact, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute > JSXIdentifier[name!=/^(?:x|y|items|onClose|minWidth|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<Menu> doesn't accept that prop. Declared props: x, y, items, onClose, minWidth, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:menus|right|key|ref|className|style|children)$/]",
        "message": "<MenuBar> doesn't accept that prop. Declared props: menus, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popover'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|anchorRef|onClose|placement|width|children|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<Popover> doesn't accept that prop. Declared props: open, anchorRef, onClose, placement, width, children, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popover'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:bottom|top)$/]",
        "message": "<Popover> placement must be one of 'bottom' | 'top'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PopUpButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|label|prefix|icon|variant|size|disabled|ariaLabel|minWidth|extraItems|key|ref|className|style|children)$/]",
        "message": "<PopUpButton> doesn't accept that prop. Declared props: options, value, onChange, label, prefix, icon, variant, size, disabled, ariaLabel, minWidth, extraItems."
      },
      {
        "selector": "JSXOpeningElement[name.name='PopUpButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bordered|plain)$/]",
        "message": "<PopUpButton> variant must be one of 'bordered' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PopUpButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|regular)$/]",
        "message": "<PopUpButton> size must be one of 'small' | 'regular'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|value|size|tone|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<ProgressIndicator> doesn't accept that prop. Declared props: kind, value, size, tone, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressIndicator'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:bar|spinner)$/]",
        "message": "<ProgressIndicator> kind must be one of 'bar' | 'spinner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressIndicator'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|error)$/]",
        "message": "<ProgressIndicator> tone must be one of 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|shortcut|autoFocus|inputRef|width|onKeyDown|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, shortcut, autoFocus, inputRef, width, onKeyDown, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|size|disabled|ariaLabel|className|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: items, value, onChange, size, disabled, ariaLabel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|regular|large)$/]",
        "message": "<SegmentedControl> size must be one of 'small' | 'regular' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|onConfirm|width|children|footer|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, onClose, onConfirm, width, children, footer, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|search|children|bottomBar|width|style|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: header, search, children, bottomBar, width, style, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarBottomBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:actions|status|size|key|ref|className|style|children)$/]",
        "message": "<SidebarBottomBar> doesn't accept that prop. Declared props: actions, status, size."
