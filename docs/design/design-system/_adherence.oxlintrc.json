        "selector": "JSXOpeningElement[name.name='Splitter'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDrag|onDragEnd|orientation|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<Splitter> doesn't accept that prop. Declared props: onDrag, onDragEnd, orientation, ariaLabel."
