      {
        "selector": "JSXOpeningElement[name.name='Splitter'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<Splitter> orientation must be one of 'vertical' | 'horizontal'."
