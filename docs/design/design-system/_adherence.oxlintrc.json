        "selector": "JSXOpeningElement[name.name='SidebarBottomBar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|small)$/]",
        "message": "<SidebarBottomBar> size must be one of 'large' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconColor|label|sublabel|count|trailing|selected|onSelect|onContextMenu|indent|disabled|onKeyDown|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: icon, iconColor, label, sublabel, count, trailing, selected, onSelect, onContextMenu, indent, disabled, onKeyDown."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|collapsible|defaultCollapsed|children|key|ref|className|style|children)$/]",
        "message": "<SidebarSection> doesn't accept that prop. Declared props: title, collapsible, defaultCollapsed, children."
